# Copy to /etc/teacher-edge/teacher-edge.env and replace both example values.
# Keep the installed file mode at 0600. Never commit the installed file.
TEACHER_EDGE_SHARED_TOKEN=replace-with-a-long-random-token
TEACHER_EDGE_ALLOWED_DEVICE_EUIS=replace-with-watcher-device-eui
# Maximum buffered body for one stock Watcher push-to-talk upload (bytes).
TEACHER_EDGE_WATCHER_AUDIO_MAX_BYTES=2000000

# Fixed localhost-only Teacher Core boundary; non-loopback values are rejected.
TEACHER_CORE_URL=http://127.0.0.1:8000
TEACHER_CORE_TIMEOUT_SECONDS=15
